<?xml version="1.0" encoding="utf-8"?>
<!--
    Whitelist buat permission signature|privileged yang dibutuhin Datura
    (org.calyxos.datura). Ini WAJIB ada di /system/etc/permissions/,
    kalau enggak, permission signature|privileged bakal DITOLAK biarpun
    APK-nya udah ditaruh di /system/priv-app dan signature-nya cocok.

    Permission MANAGE_NETWORK_POLICY & NETWORK_STACK levelnya cuma
    "signature" (bukan privileged), jadi otomatis granted asal signature
    APK cocok sama platform key ROM -- gak perlu masuk whitelist ini.
-->
<permissions>
    <privapp-permissions package="org.calyxos.datura">
        <permission name="android.permission.CONNECTIVITY_INTERNAL"/>
        <permission name="android.permission.PACKAGE_USAGE_STATS"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS"/>
    </privapp-permissions>
</permissions>
